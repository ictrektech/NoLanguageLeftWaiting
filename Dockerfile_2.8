FROM swr.cn-southwest-2.myhuaweicloud.com/ictrek/pytorch_py312:jet_2.8.0 AS builder

WORKDIR /tmp/ctranslate2

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH

ARG PIP_ARGS="--break-system-packages \
              --index-url https://mirrors.aliyun.com/pypi/simple \
              --trusted-host mirrors.aliyun.com \
              --timeout 120 --retries 5 \
              --upgrade-strategy only-if-needed"

ARG PROXY=""
ARG CUDA_ARCHS=""

# clone & build CTranslate2
RUN export HTTPS_PROXY="${PROXY}" && \
    git clone --recursive https://github.com/OpenNMT/CTranslate2.git . && \
    unset HTTPS_PROXY && \
    mkdir -p build && cd build && \
    \
    if [ -n "${CUDA_ARCHS}" ]; then \
      ARCHS="${CUDA_ARCHS}"; \
      echo "[ctranslate2] Using CUDA_ARCHS=${ARCHS}"; \
    else \
      ARCHS="87"; \
      echo "[ctranslate2] Using fallback CUDA_ARCHS=${ARCHS}"; \
    fi && \
    \
    cmake .. \
      -DWITH_CUDA=ON \
      -DWITH_MKL=OFF \
      -DWITH_CUDNN=ON \
      -DOPENMP_RUNTIME=COMP \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_CUDA_ARCHITECTURES="${ARCHS}" && \
    make -j$(nproc) && make install

RUN cd python && \
    pip3 install --break-system-packages -r install_requirements.txt ${PIP_ARGS} && \
    python3 setup.py bdist_wheel

# -----------------------------------------------------------
# runtime stage
# -----------------------------------------------------------
FROM swr.cn-southwest-2.myhuaweicloud.com/ictrek/pytorch_py312:jet_2.8.0

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH \
    HF_ENDPOINT=https://hf-mirror.com

ARG PIP_ARGS="--break-system-packages \
              --index-url https://mirrors.aliyun.com/pypi/simple \
              --trusted-host mirrors.aliyun.com \
              --timeout 120 --retries 5 \
              --upgrade-strategy only-if-needed"

WORKDIR /opt/ictrek/app/nllw

COPY --from=builder /usr/local/lib/libctranslate2.so* /usr/local/lib/
COPY --from=builder /tmp/ctranslate2/python/dist/*.whl /tmp/

RUN pip3 install --break-system-packages /tmp/*.whl ${PIP_ARGS} && rm -rf /tmp/*

RUN pip3 install --break-system-packages transformers websockets jieba ${PIP_ARGS}

COPY ./nllw /opt/ictrek/app/nllw/nllw
COPY ./stream_websocket.py /opt/ictrek/app/nllw/stream_websocket.py
COPY ./test_stream.py /opt/ictrek/app/nllw/test_stream.py

EXPOSE 8097
CMD ["python", "./stream_websocket.py"]
